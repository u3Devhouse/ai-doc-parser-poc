AI_GATEWAY_API_KEY=
AI_GATEWAY_MOCK=true
ADMIN_API_KEY=dev-admin-secret
# single = vision+structured in one call (auto-escalates to two-stage for legal templates or 15+ fields)
# two-stage = VISION_MODEL reads images, STRUCTURE_MODEL maps text to schema (recommended for PDFs and legal)
# auto = same as single, but legal / large templates still force two-stage
EXTRACTION_PIPELINE=auto
# Field count threshold for mandatory two-stage extraction (legal category always uses two-stage)
EXTRACTION_TWO_STAGE_FIELD_THRESHOLD=15
# Primary model for approve/extract structured output (not DISCOVERY_MODEL)
EXTRACTION_MODEL=openai/gpt-4o-mini
# Fallback when primary fails; defaults to DISCOVERY_MODEL then openai/gpt-4o-mini / openai/gpt-4o
EXTRACTION_FALLBACK_MODEL=openai/gpt-4o
DISCOVERY_MODEL=openai/gpt-4o-mini
PDF_RENDER_SCALE=2
CLASSIFICATION_MODEL=openai/gpt-4o-mini
VISION_MODEL=openai/gpt-4o
STRUCTURE_MODEL=openai/gpt-4o-mini
TEMPLATE_STORE_PATH=data/templates
PROPOSAL_STORE_PATH=data/proposals
MAX_PDF_PAGES=20
MAX_UPLOAD_MB=25
